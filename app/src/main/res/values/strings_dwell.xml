    <string name="dwell_dont_learn_capitalized">Learn capitalized words in lowercase</string>
    <string name="dwell_dont_learn_capitalized_summary">Capitalized (e.g. \"Hello\") and ALL CAPS (e.g. \"HELLO\") words are learned in lowercase; mixed case words (e.g. \"HELlo\") are learned as typed.</string>
    <string name="dwell_learn_only_picked">Learn new words only when tapped</string>
    <string name="dwell_learn_only_picked_summary">A word that is in no dictionary is remembered when you tap it in the suggestion strip, not when you type a space after it. The word you are typing is shown in the strip.</string>
    <string name="dwell_learn_only_picked_typed_left">Show typed word on the left</string>
    <string name="dwell_learn_only_picked_typed_left_summary">While typing, the correction or top suggestion stays in the center and the word you are typing goes next to it, on the left in left-to-right languages</string>

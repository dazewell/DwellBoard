#!/bin/sh
# Codex reads skills only from .agents/skills. Link it to .claude/skills so
# every tool reads one copy; a copy goes stale. A junction on Windows, since it
# needs no admin or Developer Mode, a symlink elsewhere. Runs on clone,
# checkout and `git worktree add`; does nothing once the link exists.
#
# Enable once per clone:  git config core.hooksPath .githooks

top="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
if [ ! -e "$top/.agents/skills" ] && [ -d "$top/.claude/skills" ]; then
  mkdir -p "$top/.agents"
  case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*)
      MSYS_NO_PATHCONV=1 cmd /c mklink /J "$(cygpath -w "$top/.agents/skills")" "$(cygpath -w "$top/.claude/skills")" >/dev/null ;;
    *) ln -s ../.claude/skills "$top/.agents/skills" ;;
  esac || echo "post-checkout: could not link .agents/skills; Codex will not see the skills." >&2
fi
exit 0
